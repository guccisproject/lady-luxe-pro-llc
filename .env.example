# Copy this file to .env and fill in your values. Never commit .env.

# Public URL of the site (used for Stripe success/cancel redirects)
SITE_URL=http://localhost:3000
PORT=3000

# Stripe — https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=
# Optional: signing secret for the webhook endpoint (/api/stripe-webhook)
STRIPE_WEBHOOK_SECRET=

# Contact form email delivery (optional). If left blank, messages are
# saved to data/messages.jsonl on the server instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=contact@ladykattluxe.shop
CONTACT_FROM=contact@ladykattluxe.shop

# Where customer accounts and orders are stored (data/ by default).
# Use a persistent disk on hosts with ephemeral filesystems.
DATA_DIR=
